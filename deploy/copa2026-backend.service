# Unit do systemd para o backend (FastAPI/uvicorn) em produção.
#
# Instalação (como root):
#   cp deploy/copa2026-backend.service /etc/systemd/system/
#   # edite User=, WorkingDirectory= e o caminho do ExecStart= para o seu ambiente
#   systemctl daemon-reload
#   systemctl enable --now copa2026-backend
#
# Um único worker: SQLite não paraleliza escritas entre processos, então
# rodar múltiplos workers do uvicorn não ajuda a performance e só aumenta o
# risco de "database is locked" em picos de escrita simultânea.

[Unit]
Description=Copa do Mundo 2026 - API (FastAPI/uvicorn)
After=network.target

[Service]
Type=simple
User=copa2026
Group=copa2026
WorkingDirectory=/opt/copa2026/backend
EnvironmentFile=/opt/copa2026/backend/.env
ExecStart=/opt/copa2026/backend/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5

# Hardening básico
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/copa2026/backend/db

[Install]
WantedBy=multi-user.target
