# Exemplo de configuração do nginx: serve o build estático do frontend e
# faz proxy de /api/ para o backend (uvicorn rodando em 127.0.0.1:8000).
#
# Instalação (como root):
#   cp deploy/nginx.conf.example /etc/nginx/sites-available/copa2026
#   # edite server_name e root para o seu domínio/caminho
#   ln -s /etc/nginx/sites-available/copa2026 /etc/nginx/sites-enabled/
#   nginx -t && systemctl reload nginx
#
# Para HTTPS, rode o certbot (Let's Encrypt) depois de confirmar que o HTTP
# funciona — ele edita este arquivo automaticamente para adicionar o bloco
# de SSL.

server {
    listen 80;
    server_name seu-dominio.com;

    root /opt/copa2026/frontend/dist;
    index index.html;

    location /api/ {
        proxy_pass http://127.0.0.1:8000/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # SPA: qualquer rota que não bata em um arquivo real cai no index.html
    # (o React Router assume a partir daí)
    location / {
        try_files $uri /index.html;
    }

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;
}
