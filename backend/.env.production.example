# Exemplo de .env para produção — copie para .env no servidor e ajuste.
# Nunca commite o .env de verdade (já está no .gitignore).

DB_PATH=/opt/copa2026/backend/db/copa2026.db
PORT=8000

# Gere uma chave forte e aleatória, ex.: openssl rand -hex 32
ADMIN_KEY=GERE_UMA_CHAVE_FORTE_AQUI

# Domínio real do frontend em produção (sem barra no final)
CORS_ORIGINS=https://seu-dominio.com
